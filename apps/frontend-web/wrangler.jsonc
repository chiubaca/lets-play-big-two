{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lets-play-big-two-web",
  "compatibility_date": "2026-03-17",
  "observability": {
    "enabled": true,
  },
  "main": "./dist/server/server.js",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
  },
}
