{
  "cli": { "version": ">=16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "internal-testing": {
      "extends": "production",
      "credentialsSource": "local",
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "internal-testing": {
      "android": { "track": "internal" }
    }
  }
}
