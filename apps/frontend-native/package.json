{
  "name": "frontend-native",
  "version": "1.1.5",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "storybook": "STORYBOOK_ENABLED=true STORYBOOK_SERVER=false expo start --dev-client --port 8082",
    "storybook:web": "STORYBOOK_ENABLED=true STORYBOOK_SERVER=false expo start --web --port 8082",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "build": "expo export --platform all",
    "check": "tsc --noEmit",
    "test": "vp test --run",
    "prebuild": "expo prebuild --no-clean --no-install",
    "update:preview": "node ../../scripts/native-update.mjs"
  },
