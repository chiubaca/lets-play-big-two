# Production is the default. Never put credentials or signing secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_BACKEND_URL=https://big-two-api.chiubaca.com
# Public EAS project UUID, shared by push notifications and OTA updates. Not a credential.
EXPO_PUBLIC_EAS_PROJECT_ID=feb26247-9b9f-4d68-b9a3-760409a03453
# Build-time path to Firebase's google-services.json for Android (or an EAS file variable).
GOOGLE_SERVICES_JSON=
# For local internal release builds only: set before prebuild AND the release build.
# EAS Build takes its channel from eas.json; do not set this in a shared EAS environment.
# EXPO_UPDATE_CHANNEL=preview
