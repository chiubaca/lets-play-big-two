{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lets-play-big-two-backend",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "migrations": [
    {
      "new_sqlite_classes": ["BigTwoRoomObject"],
      "tag": "v1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BigTwoRoomObject",
        "name": "BIG_TWO_ROOM_DURABLE_OBJECT",
      },
    ],
  },
  "d1_databases": [
    {
      "database_name": "lets-play-big-two-db",
      "database_id": "697727be-cf8b-4732-a100-b90ab45024a7",
      "binding": "BIG_TWO_DB",
      "migrations_dir": "drizzle/migrations",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "JEV_MOVE_RATE_LIMITER",
      "namespace_id": "284611",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "BETTER_AUTH_URL": "https://big-two-api.chiubaca.com",
  },
  "routes": [
    {
      "pattern": "big-two-api.chiubaca.com",
      "custom_domain": true,
    },
  ],
}
