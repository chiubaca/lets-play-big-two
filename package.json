{
  "name": "lets-play-big-two",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "dev": "vp run frontend-web#dev",
    "build:frontend": "pnpm --filter frontend-web build",
    "deploy:frontend": "pnpm --filter frontend-web run deploy",
    "build:deploy:frontend": "pnpm --filter frontend-web run build && pnpm --filter frontend-web run deploy",
    "prepare": "vp config",
    "dev:setup": "./scripts/setup-local-dev.sh",
    "dev:local": "./scripts/start-dev.sh",
    "dev:stop": "./scripts/stop-dev.sh",
    "dev:native:setup": "node scripts/native-dev.mjs setup",
    "dev:native": "node scripts/native-dev.mjs start",
    "dev:native:android": "node scripts/native-dev.mjs android",
    "native:android": "vp run frontend-native#android",
    "native:ios": "vp run frontend-native#ios",
    "storybook:native": "vp run frontend-native#storybook",
    "storybook:native:web": "vp run frontend-native#storybook:web"
  },
  "devDependencies": {
    "concurrently": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
